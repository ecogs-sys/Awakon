{
  "name": "@awakon/desktop",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "ecogs",
    "email": "ecogs.ltd@gmail.com"
  },
  "homepage": "https://github.com/ecogs/Awakon",
  "description": "AI-powered notepad for developers",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "electron-builder --config electron-builder.json",
    "dist:linux": "electron-builder --linux --config electron-builder.json",
    "dist:mac": "electron-builder --mac --config electron-builder.json",
    "dist:win": "electron-builder --win --config electron-builder.json",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "electron-updater": "^6.3.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@awakon/contracts": "workspace:*",
    "@awakon/core": "workspace:*",
    "@awakon/keymap": "workspace:*",
    "@awakon/terminal-host": "workspace:*",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
