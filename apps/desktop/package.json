{
  "name": "@awakon/desktop",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "ecogs",
    "email": "ecogs.ltd@gmail.com"
  },
  "homepage": "https://github.com/ecogs/Awakon",
  "description": "AI-powered notepad for developers",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "node scripts/build-preload.mjs && electron-vite build",
    "build:preload": "node scripts/build-preload.mjs",
    "dev": "node scripts/build-preload.mjs && electron-vite dev",
    "dist": "electron-builder --config electron-builder.json",
    "dist:dir": "electron-builder --dir --config electron-builder.json",
    "dist:linux": "electron-builder --linux deb --config electron-builder.json && electron-builder --linux AppImage --config electron-builder.json",
    "dist:mac": "electron-builder --mac --config electron-builder.json",
    "dist:win": "electron-builder --win --config electron-builder.json",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.9",
    "electron-updater": "^6.8.9",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.4.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@awakon/contracts": "workspace:*",
    "@awakon/core": "workspace:*",
    "@awakon/keymap": "workspace:*",
    "@awakon/terminal-host": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
