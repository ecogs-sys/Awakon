# Normalise line endings on check-in; check out as LF on all platforms for files
# that must have LF (shell scripts, config files parsed on Linux/macOS).

* text=auto

# Shell scripts must always use LF
*.sh text eol=lf

# Windows-only scripts use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
